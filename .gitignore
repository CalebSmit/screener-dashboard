# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.eggs/

# Testing
.pytest_cache/
pytest-cache-files-*/
htmlcov/
.coverage

# Cache & runs (large data files)
cache/
runs/
# Context-layer caches: re-downloadable (FRED series, track-record prices, SEC lookups).
# The outputs built from them (data/market_context.json, data/track_record.json,
# data/context_log/) ARE tracked - the data loop commits them.
data/market/
data/track/
data/sec/
data/insider/
# Monthly prices and split history for valuation_history.py; one download a month.
data/valhist/
# Option quotes, collected after the close because the source serves none at 02:00 and read back
# by the run (2026-10-09). Rebuilt by scripts/refresh-option-quotes.ps1; never worth committing.
data/options/

# Local SSL CA bundle (machine-specific, e.g. Avast/AV TLS interception root)
.certs/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Nightly improvement routine (run transcripts, not source)
logs/

# Misc
n_ull
